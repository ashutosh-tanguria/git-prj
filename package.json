{
  "name": "shelf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm test && npm run build && npm run size",
    "sandbox:dev": "vite --config sandbox/vite.config.ts",
    "sandbox:build": "vite build --config sandbox/vite.config.ts",
    "sandbox:preview": "vite preview --config sandbox/vite.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "5.26.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@noble/hashes": "2.0.1",
    "@tanstack/react-virtual": "3.14.26",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.18",
    "highlight.js": "11.12.0",
    "i18next": "27.1.2",
    "marked": "18.2.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pptx-preview": "1.0.7",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "31.0.1",
    "msw": "3.0.6",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
