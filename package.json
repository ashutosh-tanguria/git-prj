{
  "name": "shelf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm test && npm run build && npm run size"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-aria-components": "1.22.1",
    "i18next": "27.1.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "eslint": "10.15.0",
    "typescript-eslint": "8.72.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "stylelint": "18.0.0",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "prettier": "3.10.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
